APP_NAME=ScrapyardIO
APP_ENV=local
APP_KEY=
APP_DEBUG=true

CACHE_STORE=redis

# Default window driver. Mac: metal. Jetson: cuda (or sdl3 until CUDA is measured).
# Shared on both hosts: sdl3, open-gl, vulkan.
WINDOW_DRIVER=metal
TUBES_CANVAS=metal

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

NEO4J_SCHEME=bolt
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_DATABASE=scrapyard
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j
